PORT=8000
# Comma-separated list of frontend URLs allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resume-analyzer

# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Free key from https://console.groq.com/keys (optional: without it you still get the ATS score)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
